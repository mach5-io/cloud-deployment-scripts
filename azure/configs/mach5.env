# Mach5 deployment configuration (override values per environment before running the scripts)
RESOURCE_GROUP="mach5-dev"
LOCATION="eastus"
AKS_CLUSTER_NAME="mach5-cluster"
KUBERNETES_VERSION="1.32.6"
SERVICE_CIDR="10.1.0.0/16"
DNS_SERVICE_IP="10.1.0.10"
CLUSTER_SUBNET_ID="" # optional: supply if using an existing subnet
CLUSTER_VNET_RESOURCE_GROUP="MC_mach5-dev_mach5-cluster_eastus" # must match the VNet resource group (Azure-managed format: MC_<resource group>_<cluster name>_<location>)

STORAGE_ACCOUNT_NAME="mach5storageaccount"
STORAGE_ACCOUNT_RESOURCE_GROUP="mach5-dev"
STORAGE_CONTAINER_NAME="testbucket"

MAIN_NODEPOOL_NAME="mainnode"
MAIN_NODEPOOL_VM_SIZE="Standard_D4s_v4"
MAIN_NODEPOOL_NODE_COUNT="1"
MAIN_NODEPOOL_MIN="1"
MAIN_NODEPOOL_MAX="2"
MAIN_NODEPOOL_LABELS="mach5-main-role=true"

NODEPOOLS=(
  # name|vm_size|min|max|count|labels|nvme_required|osdisk_size_gb
  "fdbnode|Standard_DS3_v2|1|5|1|mach5-fdb-role=true|false|"
  "ingestnode|Standard_D2ads_v6|0|10|0|mach5-ingestor-role=true|true|60"
  "compactnode|Standard_D2ads_v6|0|10|0|mach5-compactor-role=true|true|60"
  "whworkernode|Standard_D4ads_v6|0|10|0|mach5-warehouse-worker-role=true|true|110"
  "whheadnode|Standard_D4ads_v6|0|10|0|mach5-warehouse-head-role=true|true|110"
)

# Helm deployment configuration
MACH5_ARTIFACT_REGISTRY="oci://us-central1-docker.pkg.dev/mach5-dev/mach5-docker-registry"
MACH5_ARTIFACT_REGISTRY_URL="https://us-central1-docker.pkg.dev"
MACH5_CACHE_PROXY_VERSION="1.13.3"
MACH5_CACHE_PROXY_CHART="mach5-cache-proxy"
MACH5_SEARCH_VERSION="6.1.0"
MACH5_SEARCH_CHART="mach5-search"
MACH5_READER_KEY_PATH="reader-key.json"

# Store configuration (Mach5 Search stores)
MACH5_STORE_NAME="mach5-store"
MACH5_STORE_PREFIX="mach5-prefix"
MACH5_STORE_TYPE="abs"
MACH5_NGINX_PORT="80"
MACH5_NGINX_SERVICE_NAME="m5s-nginx"
MACH5_STORE_LOCAL_PORT="8888"
MACH5_STORE_ROUTE_PATTERN=".*"
MACH5_STORE_ROUTE_PRIORITY=0
